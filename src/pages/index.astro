---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chip from "@/components/Chip.astro";

/**
 * PHASE 0 SIGNPOST — not the real homepage.
 *
 * The home template (recipient/occasion router, email capture, resources strip)
 * is Phase 2 work. This exists so the site has a valid root while the design is
 * under review, and to show the hero voice and the chip grid.
 */

const recipients = ["Mom", "Dad", "Grandma", "Grandpa", "Both parents", "In-laws"];

const interests = [
  "Gardening", "Golf", "Fishing", "Cooking", "Reading", "Puzzles",
  "Travel", "Coffee", "Wine", "Woodworking", "Birdwatching", "Pickleball",
];
---

<BaseLayout
  title="ParentPresents — Gifts your parents will actually use"
  description="Gift ideas for the people who raised you. Short, opinionated guides that say who each idea is wrong for, and never take payment for placement."
>
  <section class="border-b border-rule bg-surface">
    <div class="mx-auto max-w-6xl px-gutter py-16 sm:py-24">
      <div class="max-w-2xl">
        <h1 class="font-display text-4xl sm:text-[3.375rem]">
          Gifts your parents will
          <span class="text-rose-deep">actually use</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          You know them better than any list does. We just narrow it down —
          short guides, honest about who each idea is wrong for, and never paid
          for placement.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/gifts-for-lawn-lovers"
            class="inline-flex items-center rounded-control bg-rose-deep px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            See a guide
          </a>
          <a
            href="/styleguide"
            class="inline-flex items-center rounded-control border border-rule px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-rose hover:bg-rose-soft/40 hover:text-rose-deep"
          >
            Styleguide
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-gutter py-14">
    <h2 class="font-display text-2xl">Who are you shopping for?</h2>
    <ul class="mt-6 flex flex-wrap gap-2.5">
      {recipients.map((r) => <li><Chip variant="label" href="#">{r}</Chip></li>)}
    </ul>

    <h2 class="font-display mt-12 text-2xl">Or start with what they're into</h2>
    <ul class="mt-6 flex flex-wrap gap-2.5">
      {interests.map((i) => <li><Chip variant="label" href="#">{i}</Chip></li>)}
    </ul>

    <p
      class="mt-12 max-w-2xl rounded-card border border-rule bg-sunk px-5 py-4 text-sm leading-relaxed"
    >
      <strong class="font-semibold">Phase 0.</strong> Foundation and visual direction
      only. The real homepage — recipient/occasion routing, birthday-reminder capture
      and the resources strip — is Phase 2. Links above are placeholders.
    </p>
  </section>
</BaseLayout>
