---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chip from "@/components/Chip.astro";
import ImagePending from "@/components/ImagePending.astro";

/** Internal reference for the token layer. Never indexed, never linked in nav. */

const textSafe = [
  { name: "ink", hex: "#22222A", ratio: "15.6:1", use: "Body copy, headings" },
  { name: "muted", hex: "#6A6A7C", ratio: "5.2:1", use: "Meta, captions" },
  { name: "rose-deep", hex: "#B5384F", ratio: "5.6:1", use: "Primary action, emphasis" },
  { name: "blue-deep", hex: "#1F5FA8", ratio: "6.3:1", use: "Links, secondary action" },
  { name: "flag", hex: "#9A3B2E", ratio: "6.2:1", use: "Stale / needs review" },
];

const fillOnly = [
  { name: "rose", hex: "#FF8FA2", ratio: "2.2:1", use: "Brand hue — fills, strokes, tints" },
  { name: "blue", hex: "#5299E0", ratio: "2.9:1", use: "Brand hue — fills, strokes, tints" },
];

const surfaces = [
  { name: "page", hex: "#FCFCFC", use: "Page background" },
  { name: "surface", hex: "#FFFFFF", use: "Cards" },
  { name: "sunk", hex: "#F3F5F7", use: "Wells, footer" },
  { name: "rule", hex: "#E4E8EC", use: "Hairlines" },
  { name: "rose-soft", hex: "#FFE8EC", use: "Price chips, disclosure" },
  { name: "blue-soft", hex: "#E8F1FB", use: "Verified chips, email block" },
];

const scale = [
  { token: "text-4xl", label: "Page title", cls: "text-4xl font-display" },
  { token: "text-3xl", label: "Section", cls: "text-3xl font-display" },
  { token: "text-2xl", label: "Subsection", cls: "text-2xl font-display" },
  { token: "text-xl", label: "Card title", cls: "text-xl font-display-sm" },
  { token: "text-lg", label: "Lead paragraph", cls: "text-lg" },
  { token: "text-base", label: "Body copy", cls: "text-base" },
  { token: "text-sm", label: "Meta, captions", cls: "text-sm" },
  { token: "text-xs", label: "Chip labels", cls: "text-xs" },
];
---

<BaseLayout
  title="Styleguide"
  description="Internal reference for the ParentPresents token layer, type scale and chip component."
  noindex
>
  <div class="mx-auto max-w-4xl px-gutter py-12">
    <h1 class="font-display text-4xl">Styleguide</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Token layer derived from the live ParentPresents identity. Contrast ratios
      are measured against
      <code class="rounded bg-sunk px-1.5 py-0.5 text-sm">--color-page</code>.
    </p>

    <h2 class="font-display mt-14 text-2xl">Text-safe colours</h2>
    <p class="mt-2 text-sm text-muted">All pass WCAG AA at body size.</p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        textSafe.map((c) => (
          <li class="flex items-center gap-4 rounded-card border border-rule bg-surface p-4">
            <span
              class="h-11 w-11 shrink-0 rounded-control border border-rule"
              style={`background:${c.hex}`}
              aria-hidden="true"
            />
            <span class="min-w-0">
              <span class="block font-semibold">{c.name}</span>
              <span class="block text-sm text-muted">
                {c.hex} · {c.ratio} · {c.use}
              </span>
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="font-display mt-12 text-2xl">Brand hues — fill only</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Both signature colours are light and fail AA as body text against the page.
      They carry the brand as fills, strokes and tints; type in either family
      uses the <code class="rounded bg-sunk px-1">-deep</code> member.
    </p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        fillOnly.map((c) => (
          <li class="flex items-center gap-4 rounded-card border border-flag/25 bg-flag-soft p-4">
            <span
              class="h-11 w-11 shrink-0 rounded-control border border-rule"
              style={`background:${c.hex}`}
              aria-hidden="true"
            />
            <span class="min-w-0">
              <span class="block font-semibold">{c.name}</span>
              <span class="block text-sm text-muted">
                {c.hex} · {c.ratio} · {c.use}
              </span>
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="font-display mt-12 text-2xl">Surfaces</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        surfaces.map((c) => (
          <li class="rounded-card border border-rule p-4" style={`background:${c.hex}`}>
            <span class="block text-sm font-semibold">{c.name}</span>
            <span class="block text-xs text-muted">
              {c.hex} · {c.use}
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="font-display mt-14 text-2xl">Type scale</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Inter throughout, matching the live brand. The display voice comes from
      weight and negative tracking rather than a second family. Fluid from 360px
      to 1280px.
    </p>
    <div class="mt-6 divide-y divide-rule border-y border-rule">
      {
        scale.map((s) => (
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 py-4">
            <code class="w-28 shrink-0 text-xs text-muted">{s.token}</code>
            <span class={s.cls}>{s.label}</span>
          </div>
        ))
      }
    </div>

    <h2 class="font-display mt-14 text-2xl">Chips</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Category labels, price bands and the verified badge. The form follows the
      logo's construction — uniform rounded strokes, fully rounded ends, two-tone
      rose and cornflower. This is the site's one signature element.
    </p>

    <div class="mt-6 space-y-6 rounded-card border border-rule bg-surface p-6">
      <div class="flex flex-wrap items-center gap-3">
        <Chip variant="label">Gardening</Chip>
        <Chip variant="price">$25–50</Chip>
        <Chip variant="verified">Verified Aug 2026</Chip>
        <Chip variant="flag">Needs review</Chip>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <Chip variant="label" size="sm">Golf</Chip>
        <Chip variant="price" size="sm">Under $25</Chip>
        <Chip variant="verified" size="sm">Verified</Chip>
      </div>

      <div>
        <p class="mb-3 text-xs text-muted">Interactive (label variant with href)</p>
        <div class="flex flex-wrap items-center gap-3">
          <Chip variant="label" href="/gardening">Gardening</Chip>
          <Chip variant="label" href="/golf">Golf</Chip>
          <Chip variant="label" href="/fishing">Fishing</Chip>
        </div>
      </div>
    </div>

    <h2 class="font-display mt-14 text-2xl">Controls</h2>
    <div class="mt-6 flex flex-wrap items-center gap-3 rounded-card border border-rule bg-surface p-6">
      <span class="inline-flex items-center rounded-control bg-rose-deep px-5 py-2.5 text-sm font-semibold text-white">
        Primary action
      </span>
      <span class="inline-flex items-center rounded-control bg-blue-deep px-5 py-2.5 text-sm font-semibold text-white">
        Secondary action
      </span>
      <span class="inline-flex items-center rounded-control border border-rule px-5 py-2.5 text-sm font-semibold text-ink">
        Tertiary
      </span>
    </div>

    <h2 class="font-display mt-14 text-2xl">Pending imagery</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Stands in for a product photo that doesn't exist yet, and reads as
      deliberate rather than broken. Holds the real image's aspect ratio so the
      swap costs no layout shift.
    </p>
    <div class="mt-6 flex flex-wrap gap-4 rounded-card border border-rule bg-surface p-6">
      <ImagePending class="w-40" />
      <ImagePending class="w-40" ratio="aspect-square" />
    </div>
  </div>
</BaseLayout>
