---
/**
 * Deliberate stand-in for a product photo that does not exist yet.
 *
 * Reads as "nothing here on purpose" rather than as a broken <img>, which the
 * previous bare grey box did not. Product imagery arrives with the product data
 * layer in Phase 1; until a product has verifiedDate + verifiedBy it has no
 * image either, and this renders in its place.
 *
 * The aspect ratio is fixed so swapping in a real <Image /> later causes no
 * layout shift.
 */
interface Props {
  /** Tailwind aspect utility — must match the real image's ratio. */
  ratio?: string;
  class?: string;
}

const { ratio = "aspect-[4/5]", class: className = "" } = Astro.props;
---

<div
  class:list={[
    ratio,
    "flex flex-col items-center justify-center gap-2 rounded-card border border-dashed border-rule bg-sunk px-3 text-center",
    className,
  ]}
>
  <svg
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-rose"
    aria-hidden="true"
  >
    <rect x="3" y="8" width="18" height="13" rx="2"></rect>
    <path d="M3 12h18M12 8v13"></path>
    <path d="M12 8S9.5 3.5 7 4.5 8 8 12 8s6.5-.5 5-3.5S12 8 12 8Z"></path>
  </svg>
  <span class="text-2xs leading-tight font-medium text-muted">
    Photo added at verification
  </span>
</div>
