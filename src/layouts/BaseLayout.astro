---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import "@/styles/global.css";

/**
 * Phase 0 base layout. Schema generation, OG/Pinterest image wiring and the
 * analytics bootstrap all land here in Phases 4-5 — the props are deliberately
 * minimal until those exist rather than stubbed out now.
 */
interface Props {
  title: string;
  description: string;
  /** Set on utility pages that should stay out of the index. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

if (title.length > 60) {
  throw new Error(
    `Title exceeds 60 characters (${title.length}): "${title}". ` +
      `Titles are truncated in search results past ~60.`,
  );
}

if (description.length > 155) {
  throw new Error(
    `Description exceeds 155 characters (${description.length}) on "${title}".`,
  );
}

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Rendered from the logo mark itself rather than a hand-drawn SVG
         approximation — the two interlocking P's don't survive simplification. -->
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <!-- One variable face covers headings and body, so it is render-critical.
         Preloading avoids the swap flash that would show up as a CLS penalty. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ParentPresents" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-control focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-page"
    >
      Skip to content
    </a>

    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
