---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import "@/styles/global.css";

/**
 * Phase 0 base layout. Schema generation, OG/Pinterest image wiring and the
 * analytics bootstrap all land here in Phases 4-5 — the props are deliberately
 * minimal until those exist rather than stubbed out now.
 */
interface Props {
  title: string;
  description: string;
  /** Set on utility pages that should stay out of the index. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

if (title.length > 60) {
  throw new Error(
    `Title exceeds 60 characters (${title.length}): "${title}". ` +
      `Titles are truncated in search results past ~60.`,
  );
}

if (description.length > 155) {
  throw new Error(
    `Description exceeds 155 characters (${description.length}) on "${title}".`,
  );
}

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Both faces are render-critical: Fraunces sets every heading, Karla all
         body copy. Preloading avoids the swap flash that would otherwise show
         up as a CLS penalty. -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/karla-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ParentPresents" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-indigo focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      Skip to content
    </a>

    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
